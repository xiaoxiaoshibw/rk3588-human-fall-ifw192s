+    def test_recover_unstucks_transferring(self):
+        # 客户端中断留下的 transferring 卡死：recover 退回 ready；已非 transferring 拒绝
+        with tempfile.TemporaryDirectory() as tmp:
+            srv, cfg = self._start_board(tmp)
