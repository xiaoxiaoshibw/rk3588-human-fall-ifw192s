+                              "created_iso": "2026-10-07T12:00:03+08:00"})
+            srv.store.transition(sid, "transferring")
+            ok, reason = fetch.recover(sid)
+            self.assertTrue(ok, reason)
+            self.assertEqual(srv.store.get(sid)["state"], "ready")
+            ok, reason = fetch.recover(sid)
+            self.assertFalse(ok)
