+        # 旧行为 PATCH transferring 会被状态机 409 拒（transferred 只能转 purged）。
+        with tempfile.TemporaryDirectory() as tmp:
+            srv, cfg = self._start_board(tmp)
+            sid = "cap_20261007_120002"
