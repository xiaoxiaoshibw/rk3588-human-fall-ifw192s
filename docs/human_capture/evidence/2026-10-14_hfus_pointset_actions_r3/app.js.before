'use strict';
const $=id=>document.getElementById(id), canvas=$('cloud'),ctx=canvas.getContext('2d');
let actions=[],catalog=null,current=null,record=null,fi=0,obj=null,selected=new Set(),playing=false,timer=null,request=0;
let reviewedParts=new Map(), diagnostic=null, experiment=null, baselineRecord=null;
const postureNames={STANDING:'站立',CROUCH_OR_SIT:'坐/蹲低姿态',DESCENDING:'身体下降',LOW_PENDING:'低姿态观察中',LYING:'持续倒地姿态',INITIAL_LOW_POSTURE:'初始低姿态',LOST:'目标缺测'};const postureName=s=>postureNames[s]||s;
const partColors={HEAD:'#ffad78',TORSO:'#88e0a6',LEFT_ARM:'#bd9aff',RIGHT_ARM:'#f791bf',LEFT_LEG:'#87a7ff',RIGHT_LEG:'#60d6de',UNKNOWN:'#8b96a1'};
let yaw=-.45,pitch=.55,scale=160,center=[1.5,1.2,1],drag=null,moved=false,projected=[];
async function api(url,options){if(!options&&(url.startsWith('/api/')||url.startsWith('/data/')))url+=(url.includes('?')?'&':'?')+'dataset='+$('dataset').value;const r=await fetch(url,options);const data=await r.json();if(!r.ok)throw Error(data.error||r.status);return data;}
function project(p){let x=p[0]-center[0],y=p[1]-center[1],z=p[2]-center[2],a=Math.cos(yaw)*x-Math.sin(yaw)*y,b=Math.sin(yaw)*x+Math.cos(yaw)*y;return [canvas.width/2+a*scale,canvas.height/2+(Math.sin(pitch)*b-Math.cos(pitch)*z)*scale];}
function path(points,color,width=1,closed=false){ctx.beginPath();points.map(project).forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));if(closed)ctx.closePath();ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke();}
function draw(){drawLayers();canvas.width=canvas.clientWidth;canvas.height=canvas.clientHeight;ctx.clearRect(0,0,canvas.width,canvas.height);for(let x=-1;x<=7;x++)path([[x,-2,0],[x,10,0]],'#2a3c4d');for(let y=-2;y<=10;y++)path([[-1,y,0],[7,y,0]],'#2a3c4d');
if(catalog)path(catalog.roi_xy.map(p=>[...p,0]),'#ffd251',4,true);
if(record&&$('context').checked){ctx.fillStyle='#687c8e';for(const p of record.foreground_display){let q=project(p);ctx.fillRect(...q,1,1);}}
projected=[];
if(!obj)return;
for(let i=0;i<obj.points.length;i++){const p=obj.points[i],id=obj.display_source_indices[i],q=project(p);projected.push({id,q});ctx.fillStyle=experiment?.added_members.some(m=>m.source_index===id)?'#ff9b43':selected.has(id)?'#ffdf67':reviewedParts.has(id)?partColors[reviewedParts.get(id)]:$('mode').value==='reference'?'#8fa5ff':'#55d3e2';ctx.fillRect(q[0],q[1],selected.has(id)?5:3,selected.has(id)?5:3);}
const a=obj.bbox.min,b=obj.bbox.max,v=[[a[0],a[1],a[2]],[b[0],a[1],a[2]],[b[0],b[1],a[2]],[a[0],b[1],a[2]],[a[0],a[1],b[2]],[b[0],a[1],b[2]],[b[0],b[1],b[2]],[a[0],b[1],b[2]]];for(const [i,j] of [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]])path([v[i],v[j]],'#f2b061',2);
const sk=obj.skeleton;for(const [a,b] of sk.edges)path([sk.nodes[a].xyz,sk.nodes[b].xyz],'#fd7da3',3);for(const n of Object.values(sk.nodes)){if(!n.valid)continue;const q=project(n.xyz);ctx.beginPath();ctx.arc(q[0],q[1],5,0,2*Math.PI);ctx.fillStyle='#ffb5cc';ctx.fill();}
}
function selectObject(){const list=record[$('mode').value];obj=list[Number($('object').value)]||null;selected.clear();$('picked').textContent='0 点';$('message').textContent='';
if(obj){center=obj.bbox.min.map((v,i)=>(v+obj.bbox.max[i])/2);const span=Math.max(...obj.bbox.max.map((v,i)=>v-obj.bbox.min[i]),1);scale=Math.min(220,340/span);}
$('experimentDownload').hidden=!experiment;$('experimentDownload').href=experiment?`/api/experiment?sid=${record.session_id}&fi=${record.frame_index}&variant=${experiment.variant}&dataset=actions`:'#';const indep=obj?.independence;const scope=$('mode').value;const diagnostics=record.metrics[scope]?.persons||[];
$('metrics').replaceChildren();const texts=[`原始 ${record.raw_count} 点`,`背景匹配删除 ${record.background_removed} 点`,`前景 ${record.fg_count} 点`,`小区前景 ${record.roi_fg_count} 点`];
if(record.posture?.time_reset)texts.push('时间gap · 历史已重置');if(record.posture){texts.push(`姿态 ${postureName(record.posture.state)}`,`高度P90 ${record.posture.height_p90?.toFixed(2)??'—'} m`,`倒地候选 ${record.posture.event??'无'} · 非确认跌倒`);}if(obj){texts.push(`当前对象 ${obj.point_count} 点`,`区内比例 ${(100*obj.roi_point_fraction).toFixed(1)}%`);if(indep)texts.push(`几何独立性 ${indep.score_0_100}/100`,`邻近背景 ${(100*indep.near_background_fraction).toFixed(1)}%`,obj.model_status?'使用原三维聚类':`PointNet ${obj.pointnet_prob.toFixed(3)}`,obj.model_status?'几何定位 · 模型未参与':`XYZ-RF ${(obj.rf_xyz_prob??0).toFixed(3)}`,`${indep.separation_status==='GEOMETRICALLY_SEPARATE'?'几何分离较好':'接触或碎裂风险'}`);}
if(baselineRecord&&$('dataset').value==='actions'){const old=baselineRecord.body_3d[0];texts.push(`旧目标 ${old?.point_count??0} / 当前 ${obj?.point_count??0} 点`,`方案 ${$('variant').selectedOptions[0].textContent}`);if(experiment){const s=experiment.stats;texts.push(`成员 +${s.added_count} / -${s.deleted_count}`,`粗节点 ${s.valid_nodes}/13 · 人体精度/家具污染率 UNKNOWN`,`方向 ${s.direction_source} · 当前点支撑，无预测关节`);const ref=obj?.skeleton.direction?.reference;if(ref)texts.push(`方向参考 f${ref.fi} · ${(record.t_sec-ref.t_sec).toFixed(3)}s 前可靠轴，未回填节点`);}}for(const t of texts){const el=document.createElement('span');el.textContent=t;$('metrics').append(el);}
for(const d of diagnostics){const ref=record.reference.find(p=>p.id===d.reference_id),ids=new Set(obj?.source_indices||[]),hits=(ref?.source_indices||[]).filter(i=>ids.has(i)).length;const el=document.createElement('span');el.className='warn';el.textContent=`当前所选簇覆盖 ${(100*hits/d.reference_count).toFixed(1)}% (${hits}/${d.reference_count}) · GT最佳簇上界 ${(100*d.reference_coverage).toFixed(1)}% · 完整精度 UNKNOWN`;if(d.best_cluster===obj?.id)el.textContent+=` · 已标家具 ${d.furniture_points} 点 · 未标身份 ${d.unannotated_points} 点 · 碎片 ${d.fragments_with_reference_points}`;$('metrics').append(el);}
$('nodes').replaceChildren();for(const [name,n] of Object.entries(obj?.skeleton.nodes||{})){const tr=document.createElement('tr');for(const text of [name,n.valid?'点支持的区域估计':'UNKNOWN',n.support_source_indices.length]){const td=document.createElement('td');td.textContent=text;tr.append(td);}$('nodes').append(tr);}draw();}
function updateObjects(){const list=record[$('mode').value];$('object').replaceChildren();list.forEach((o,i)=>{const option=document.createElement('option');option.value=i;option.textContent=`${o.id} · ${o.point_count} 点`;$('object').append(option);});
if(list.length&&$('mode').value!=='reference'){let best=0;for(let i=1;i<list.length;i++){const rank=o=>(o[$('model').value]??0)*(o.independence.score_0_100/100)*Math.log1p(o.point_count);if(rank(list[i])>rank(list[best]))best=i;}$('object').value=best;}
$('status').textContent=`${current.activity} · 帧 ${fi}/${current.frame_count-1} · ${record.t_sec.toFixed(2)} s · ${list.length} 个${$('mode').value==='reference'?'人工参照对象':'自动候选'} · ${current.reference_status==='AI_INFERRED_NOT_MANUAL_GT'?'自动定位':current.reference_status}${record.posture?' · '+postureName(record.posture.state):''}${!list.length?' · 当前模式无对象（可查看全场对照）':''}`;selectObject();}
async function loadFrame(value){
const token=++request;fi=Math.max(0,Math.min(current.frame_count-1,value));if(current.available_frames)fi=current.available_frames.reduce((a,b)=>Math.abs(b-fi)<Math.abs(a-fi)?b:a);
$('time').value=fi;record=null;obj=null;diagnostic=null;experiment=null;baselineRecord=null;reviewedParts.clear();draw();
try{const binding=`sid=${current.session_id}&fi=${fi}`,isActions=$('dataset').value==='actions',variant=$('variant').value;
const [data,labels,diag,exp]=await Promise.all([api('/api/frame?'+binding),api('/api/parts?'+binding),isActions&&$('diagnose').checked?api('/api/diagnostic?'+binding):null,isActions&&variant!=='baseline'?api('/api/experiment?'+binding+'&variant='+variant):null]);
if(token!==request)return;baselineRecord=data;diagnostic=diag;experiment=exp;record=exp?{...data,body_3d:exp.body_3d,posture:exp.posture}:data;
for(const r of labels.records)for(const id of r.source_indices)reviewedParts.set(id,r.part_class);
$('sourceDownload').href='/api/source-members?'+binding+'&dataset=actions';updateObjects();if(labels.rejected?.length)$('message').textContent=`${labels.rejected.length} 条标注绑定无效，未作为人工审核显示。`;
}catch(e){if(token!==request)return;record=null;obj=null;diagnostic=null;experiment=null;baselineRecord=null;reviewedParts.clear();draw();$('status').textContent=e.message;stop();}}

function stop(){playing=false;clearTimeout(timer);$('play').textContent='播放';}
async function tick(){if(!playing)return;if(fi>=current.frame_count-1){stop();return;}await loadFrame(stepFrame(1));if(playing)timer=setTimeout(tick,110);}
function stepFrame(dir){const frames=current.available_frames;return frames?frames[Math.max(0,Math.min(frames.length-1,frames.indexOf(fi)+dir))]:fi+dir;}
async function choose(s){stop();current=s;fi=0;$('time').max=s.frame_count-1;$('time').value=0;for(const b of $('sessions').children)b.classList.toggle('active',b.dataset.sid===s.session_id);$('download').href=`/data/${s.session_id}/${$('dataset').value==='actions'?'candidate_source_indices.npz':'human_reference.npz'}?dataset=${$('dataset').value}`;$('download').textContent=$('dataset').value==='actions'?'导出R1旧基线候选源点索引（非GT）':'导出本会话已有人工人体点集（NPZ）';$('download').hidden=s.reference_status==='BLOCKED_INVALID_BINDING'||s.activity.startsWith('S1');$('summary').href=`/data/${s.session_id}/summary.json?dataset=${$('dataset').value}`;await loadFrame(0);}
$('model').onchange=()=>{if(record)updateObjects();};$('marked').onclick=async()=>{stop();const summary=await api(`/data/${current.session_id}/summary.json`);const ids=summary.frames.filter(f=>f.reference_persons>0).map(f=>f.fi);if(!ids.length){$('message').textContent='该会话没有有效绑定的人工人体已标帧。';return;}const next=ids.find(i=>i>fi)??ids[0];$('mode').value='reference';loadFrame(next);};
$('mode').onchange=()=>{if(record)updateObjects();};$('object').onchange=selectObject;$('context').onchange=draw;$('time').oninput=()=>{stop();loadFrame(Number($('time').value));};$('next').onclick=()=>{stop();loadFrame(stepFrame(1));};$('prev').onclick=()=>{stop();loadFrame(stepFrame(-1));};$('play').onclick=()=>{if(playing)stop();else{playing=true;$('play').textContent='暂停';tick();}};
$('front').onclick=()=>{yaw=0;pitch=0;draw();};$('top').onclick=()=>{yaw=0;pitch=Math.PI/2;draw();};$('orbit').onclick=()=>{yaw=-.45;pitch=.55;draw();};
canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];moved=false;canvas.setPointerCapture(e.pointerId);};canvas.onpointermove=e=>{if(!drag)return;const dx=e.clientX-drag[0],dy=e.clientY-drag[1];if(Math.abs(dx)+Math.abs(dy)>2)moved=true;if(!$('annotate').checked){yaw+=dx*.008;pitch=Math.max(-.1,Math.min(Math.PI/2,pitch+dy*.008));}drag=[e.clientX,e.clientY];draw();};
canvas.onpointerup=e=>{drag=null;if(moved||!$('annotate').checked)return;const rect=canvas.getBoundingClientRect(),x=e.clientX-rect.left,y=e.clientY-rect.top;for(const p of projected)if(Math.hypot(p.q[0]-x,p.q[1]-y)<12)selected.add(p.id);$('picked').textContent=`${selected.size} 点`;draw();};canvas.onwheel=e=>{e.preventDefault();scale=Math.max(20,Math.min(600,scale*Math.exp(-e.deltaY*.001)));draw();};
$('clear').onclick=()=>{selected.clear();$('picked').textContent='0 点';draw();};
$('save').onclick=async()=>{if(!selected.size||!obj){$('message').textContent='请先选择点。';return;}if(!$('reviewer').value.trim()){$('message').textContent='请填写实际审核人姓名。';return;}const binding={sid:current.session_id,frame:fi,token:request,ids:[...selected],part:$('part').value};const same=()=>current?.session_id===binding.sid&&fi===binding.frame&&request===binding.token;const payload={schema_version:'pointset-annotation/1',session_id:binding.sid,frame_index:binding.frame,source_sha256:current.source_sha256,object_id:obj.id,object_scope:$('mode').value,object_kind:obj.kind,source_indices:binding.ids,part_class:binding.part,reviewer:$('reviewer').value.trim(),provenance:'HUMAN_REVIEW'};try{await api('/api/parts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!same())return;for(const id of binding.ids)reviewedParts.set(id,binding.part);draw();$('message').textContent=`已追加保存 ${binding.ids.length} 个点的 ${binding.part} 标注。`;}catch(e){if(same())$('message').textContent=e.message;}};
window.onresize=draw;
async function initialize(){try{stop();const setup=++request;record=null;obj=null;diagnostic=null;experiment=null;baselineRecord=null;draw();const nextCatalog=await api('/api/catalog');if(setup!==request)return;const nextActions=await api('/api/actions');if(setup!==request)return;catalog=nextCatalog;actions=nextActions;$('sessions').replaceChildren();const isActions=$('dataset').value==='actions';$('mode').value=isActions?'body_3d':'full_3d';$('model').hidden=isActions;$('parts').hidden=isActions;$('researchControls').hidden=!isActions;$('marked').hidden=isActions;for(const option of $('mode').options)option.hidden=isActions?option.value!=='body_3d':option.value==='body_3d';for(const s of catalog.sessions){const b=document.createElement('button');b.dataset.sid=s.session_id;const a=actions.find(a=>a.session_id===s.session_id);b.textContent=`${s.activity}\n${s.frame_count} 帧 · ${s.duration_sec.toFixed(1)} s\n目标观测 ${a?.roi_candidate_frames??'—'} 帧`;b.onclick=()=>choose(s);$('sessions').append(b);}const q=new URLSearchParams(location.search);await choose(catalog.sessions.find(s=>s.session_id===q.get('sid'))||catalog.sessions.find(s=>s.activity==='S3-walk-x-near')||catalog.sessions[0]);if(q.has('fi'))await loadFrame(Number(q.get('fi')));$('reviewQueue').replaceChildren();if(isActions){for(const a of actions)for(const e of a.events||[]){const link=document.createElement('a');link.textContent=`${catalog.sessions.find(s=>s.session_id===a.session_id).activity} · ${e.t_sec.toFixed(2)}s 倒地姿态候选（非确认跌倒）`;link.href=`?dataset=actions&sid=${a.session_id}&fi=${e.frame}`;$('reviewQueue').append(link,document.createElement('br'));}}else{const queue=await api('/api/review-queue');for(const w of queue.windows){const a=document.createElement('a');a.href='?dataset=legacy&sid='+encodeURIComponent(w.sid)+'&fi='+w.frames[0];a.textContent=`${w.activity} · PROPOSED · 帧 ${w.frames.join(', ')} `;$('reviewQueue').append(a,document.createElement('br'));}}}catch(e){$('status').textContent=e.message;}}

const layerNames={raw:'原始有效点',background_removed:'背景删除点',foreground:'完整前景成员',target:'R1旧目标',unselected:'未选碎片/噪声'};
const layerColors={raw:'#8294a6',background_removed:'#e37c69',foreground:'#8daa70',target:'#12cadd',unselected:'#bb83ca'};
for(const key of Object.keys(layerNames)){const box=document.createElement('div'),title=document.createElement('h3'),c=document.createElement('canvas');title.id='layerTitle_'+key;c.id='layer_'+key;c.setAttribute('aria-label',layerNames[key]);box.append(title,c);$('layers').append(box);
c.onpointerdown=e=>{drag=[e.clientX,e.clientY];moved=false;c.setPointerCapture(e.pointerId);};c.onpointermove=canvas.onpointermove;c.onwheel=canvas.onwheel;c.onpointerup=e=>{drag=null;if(moved||!diagnostic)return;const rect=c.getBoundingClientRect(),x=e.clientX-rect.left,y=e.clientY-rect.top;const layer=diagnostic.layers[key];let best=-1,d=10;for(let i=0;i<layer.points.length;i++){const q=layerProject(layer.points[i],c),gap=Math.hypot(q[0]-x,q[1]-y);if(gap<d){best=i;d=gap;}}if(best>=0)$('sourceHover').textContent=`AI_INFERRED检查 · ${diagnostic.sid} / f${diagnostic.fi} / source ${layer.display_source_indices[best]} · ${layerNames[key]} · 身份UNKNOWN`;};}
function layerProject(p,c){const q=project(p),ratio=Math.min(c.width/400,c.height/510);return [c.width/2+(q[0]-canvas.width/2)*ratio,c.height/2+(q[1]-canvas.height/2)*ratio];}
function drawLayers(){const show=$('dataset').value==='actions'&&$('diagnose').checked;$('diagnosticPanel').hidden=!show;
for(const key of Object.keys(layerNames)){const c=$('layer_'+key);if(!c)continue;c.width=c.clientWidth||240;c.height=c.clientHeight||220;const cx=c.getContext('2d');cx.clearRect(0,0,c.width,c.height);const layer=diagnostic?.layers[key];$('layerTitle_'+key).textContent=layerNames[key]+(layer?` · ${layer.count} 点 / 显示 ${layer.display_count}${layer.sampled?'（采样）':''}`:' · 等待同帧数据');if(!layer)continue;cx.fillStyle=layerColors[key];for(const p of layer.points){const q=layerProject(p,c);cx.fillRect(q[0],q[1],1.5,1.5);}}
if(diagnostic){$('layerStatus').textContent=`${diagnostic.sid} / f${diagnostic.fi} · 五层使用同一源帧和坐标 · 原始层为有效量程点；高度范围外另存outside_domain · 五层是R1处理路径，主图展示所选方案；人体精度/污染率UNKNOWN`;$('fragmentDetails').textContent=JSON.stringify({risks:diagnostic.risk_status,axis:diagnostic.body_axis_ambiguity,near_removed:diagnostic.near_removed_source_indices,fragments:diagnostic.fragments.map(f=>({...f,source_indices:f.source_indices.slice(0,12)})),experiment:experiment?.stats,added_members:experiment?.added_members,direction:obj?.skeleton.direction},null,2);}}
$('variant').onchange=()=>{stop();loadFrame(fi);};$('diagnose').onchange=()=>{stop();loadFrame(fi);};
$('case').onchange=async()=>{if(!$('case').value)return;const [sid,f]=$('case').value.split('/');const s=catalog.sessions.find(s=>s.session_id===sid);await choose(s);await loadFrame(Number(f));};
api('/api/research').then(r=>{for(const c of r.cases.filter(c=>c.roles[0]!=='AXIS_OR_NEIGHBOR')){const o=document.createElement('option');o.value=c.sid+'/'+c.fi;o.textContent=c.sid.slice(-6)+' / f'+c.fi+' · '+c.roles.join(' / ');$('case').append(o);}}).catch(e=>{$('version').textContent='R2研究尚未完成：'+e.message;});
$('dataset').onchange=initialize;
$('dataset').value=new URLSearchParams(location.search).get('dataset')==='legacy'?'legacy':'actions';initialize();
