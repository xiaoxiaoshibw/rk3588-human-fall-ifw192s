_m: 0.7\n55:   low_min_duration_s: 1.5\n56:   confirmed_min_low_duration_s: 3.0\n57:   recovery_fraction: 0.6\n58:   recovery_min_duration_s: 1.0\n59:   # Default OFF: the real geometric mode is not human-labelled/accepted, so\n60:   # online confirmed is disabled. Synthetic fixtures may enable both explicitly.\n61:   mode_verified: false\n62:   allow_confirmed: false\n\n(End of file - total 62 lines)\n</content>","metadata":{"preview":"# HF-04..06 perception/fall defaults. Independent of config/default.yaml\n# (HF-01 health/manifest, frozen) and config/geometry.yaml (HF-03). Lengths in\n# metres, durations in seconds, angles in radians. Every section maps directly\n# onto the corresponding core module's resolve_settings().\ncandidates:\n  range_min_m: 0.8\n  range_max_m: 8.0\n  height_min_m: -0.3\n  height_max_m: 2.5\n  voxel_size_m: 0.08\n  cluster_cell_m: 0.25\n  max_points: 60000\n  min_cluster_points: 25\n  preferred_cluster_points: 80\n  pca_min_points: 12\n  pca_axis_ratio: 2.5\n  background_cell_m: 0.1\n  background_z_cell_m: 0.1\nassociation:\n  gate_m: 0.8","truncated":false,"loaded":[],"display":{"type":"file","path":"D:\\Code\\ldiar\\src\\human_fall_detection\\config\\perception.yaml","text":"# HF-04..06 perception/fall defaults. Independent of config/default.yaml\n# (HF-01 health/manifest, frozen) and config/geometry.yaml (HF-03). Lengths in\n# metres, durations in seconds, angles in radians. Every section maps directly\n# onto the corresponding core module's resolve_settings().\ncandidates:\n  range_min_m: 0.8\n  range_max_m: 8.0\n  height_min_m: -0.3\n  height_max_m: 2.5\n  voxel_size_m: 0.08\n  cluster_cell_m: 0.25\n  max_points: 60000\n  min_cluster_points: 25\n  preferred_cluster_points: 80\n  pca_min_points: 12\n  pca_axis_ratio: 2.5\n  background_cell_m: 0.1\n  background_z_cell_m: 0.1\nassociation:\n  gate_m: 0.8\n  ambiguity_margin_m: 0.2\n  max_speed_m_s: 2.5\n  max_size_ratio: 3.0\ntracking:\n  gate_m: 0.8\n  ambiguity_margin_m: 0.2\n  max_speed_m_s: 2.5\n  occlusion_timeout_s: 1.5\n  lost_timeout_s: 3.0\n  velocity_smoothing: 0.5\n  max_size_ratio: 3.0\n  history_size: 64\nselection:\n  snapshot_ttl_s: 2.0\n  request_cache_size: 64\n  snapshot_cache_size: 16\nbaseline:\n  require_seconds: 3.0\n  max_duration_s: 10.0\n  min_samples: 15\n  min_point_count: 60\n  max_position_spread_m: 0.25\n  height_min_m: 0.8\n  height_max_m: 2.2\n  max_height_std_m: 0.12\nfeatures:\n  window_s: 1.2\n  max_history: 64\n  low_height_m: 0.7\n  near_ground_tolerance_m: 0.05\nfall:\n  descending_min_drop_m: 0.35\n  descending_min_rate_m_s: 0.35\n  low_height_m: 0.7\n  low_min_duration_s: 1.5\n  confirmed_min_low_duration_s: 3.0\n  recovery_fraction: 0.6\n  recovery_min_duration_s: 1.0\n  # Default OFF: the real geometric mode is not human-labelled/accepted, so\n  # online confirmed is disabled. Synthetic fixtures may enable both explicitly.\n  mode_verified: false\n  allow_confirmed: false","lineStart":1,"lineEnd":62,"totalLines":62,"truncated":false}},"title":"src\\human_fall_detection\\config\\perception.yaml","time":{"start":1790810560857,"end":1790810560891}},"id":"prt_0f4a083da001Sc7KoVEn3KfIaW","sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","messageID":"msg_0f4a056b3001XXnKjgRpEE4RBc"}}
