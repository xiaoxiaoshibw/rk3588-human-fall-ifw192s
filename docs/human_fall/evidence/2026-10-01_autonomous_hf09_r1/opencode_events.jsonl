round.get(\"status\")\n655:         quality[\"calibration_version\"] = (self.calibration or {}).get(\"calibration_id\")\n656:         quality[\"device_motion\"] = \"unknown\"\n657:         return quality\n658: \n659:     def status_state(self, now):\n660:         \"\"\"A state payload when no new cloud arrived (freshness refresh only).\n661: \n662:         The measurement contents are those of the last processed frame; only the\n663:         receive time, freshness and reason codes are recomputed, so a stalled\n664:         stream is reported as stale/invalid instead of holding a green lock.\n665:         \"\"\"\n666:         now = finite_or_none(now) or 0.0\n667:         with self._lock:\n668:             if self._last_state is None:\n669:                 state = self._state_payload(now, None, False,\n670:                                             self.tracker.snapshot(), {}, {}, None)\n671:             else:\n672:                 state = dict(self._last_state)\n673:                 state[\"time_received_s\"] = finite_or_none(now)\n674:                 state[\"sensor_quality\"] = self._sensor_quality(now)\n675:                 state[\"event_persistence\"] = self.event_log.report()\n676:                 state[\"recent_events\"] = list(self.event_log.recent)\n677:                 state[\"baseline\"] = self.baseline.snapshot()\n678:                 state[\"observability\"] = self._observability(\n679:                     self.cloud_timebase.streams[\"cloud\"],\n680:                     self._latest_valid_snapshot is not None, now)\n681:                 reasons = []\n682:                 for code in (self.cloud_timebase.reason_codes(now)\n683:                              + self.aux_timebase.reason_codes(now)\n684:                              + list(state.get(\"reason_codes\") or [])):\n685:                     if code and code not in reasons:\n686:                         reasons.append(code)\n687:                 state[\"reason_codes\"] = reasons\n688:            