{"type":"tool_use","timestamp":1790810659657,"sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","part":{"type":"tool","tool":"read","callID":"call_ed1b7b603f714470acf4338b","state":{"status":"completed","input":{"filePath":"D:\\Code\\ldiar\\src\\human_fall_detection\\core\\node_runtime.py","offset":225,"limit":220},"output":"<path>D:\\Code\\ldiar\\src\\human_fall_detection\\core\\node_runtime.py</path>\n<type>file</type>\n<content>\n225: class FallNodeCore:\n226:     \"\"\"One-frame-at-a-time geometry/selection/fall runtime (no ROS here).\"\"\"\n227: \n228:     def __init__(self, session_id, settings=None, ground=None, calibration=None,\n229:                  transform=None, background=None, event_path=None,\n230:                  recent_events=64, expected_frame=\"innolidar\",\n231:                  cloud_timeout_s=0.6, imu_timeout_s=0.3, device_timeout_s=0.6,\n232:                  max_forward_jump_s=30.0, clock_domain=\"monotonic\"):\n233:         sections = settings or {}\n234:         self.session_id = session_id\n235:         self.settings = sections\n236:         self.ground = ground\n237:         if calibration is not None and calibration.get(\"calibration_id\"):\n238:             self.calibration = calibration\n239:         else:\n240:             # Ground-only config: derive a stable parameter version (physical\n241:             # verification flags stay false) so the baseline binding is usable.\n242:             self.calibration = derive_ground_calibration(ground, expected_frame) \\\n243:                 or calibration\n244:         self.transform = transform\n245:         self.background = background\n246:         self.expected_frame = expected_frame\n247:         self.clock_domain = clock_domain if clock_domain in CLOCK_DOMAINS else \"monotonic\"\n248:         self._lock = threading.RLock()\n249:         self.tracker = TargetTracker(session_id, sections.get(\"tracking\"))\n250:         self.features = FeatureExtractor(session_id, sections.get(\"features\"))\n251:         self.fall = FallStateMachine(session_id, sections.get(\"fall\"))\n252:         self.baseline = StanceBaselineCollector(session_id, sections.get(\"baseline\"))\n253:         self.selection = SelectionBackend(session_id, self.tracker, self.baseline,\n254:                                           sections.get(\"selection\"))\n255:         self.candidate_settings = sections.get(\"candidates\")\n256:         # Required cloud and auxiliary streams live in separate time bases so an\n257:         # unverified IMU/device clock reset cannot rewind the geometry epoch.\n258:         self.cloud_timebase = TimebaseSession(session_id, self.clock_domain,\n259:                                               max_forward_jump_s=max_forward_jump_s)\n260:         self.cloud_timebase.register(\"cloud\", cloud_timeout_s, required=True)\n261:         self.aux_timebase = TimebaseSession(session_id, self.clock_domain,\n262:                                             max_forward_jump_s=max_forward_jump_s)\n263:         self.aux_timebase.register(\"imu\", imu_timeout_s, required=False)\n264:         self.aux_timebase.register(\"device\", device_timeout_s, required=False)\n265:         self.event_log = EventLog(event_path, recent_events)\n266:         self.imu_quality = {\"messages\": 0, \"finite\": None, \"last_receive_s\": None}\n267:         self.device_quality = {\"messages\": 0, \"last_receive_s\": None}\n268:         self._last_candidate = None\n269:         self._last_snapshot_id = None\n270:         self._latest_valid_snapshot = None\n271:         self._baseline_request_id = None\n272:         self._baseline_status = self.baseline.status\n273:         self._last_state = None\n274:         self.frame_count = 0\n275:         self.invalid_frames = 0\n276: \n277:     # -- auxiliary stream bookkeeping (never gates the required geometry) ----\n278: \n279:     def note_imu(self, receive_s, stamp, frame_id, finite):\n280:         with self._lock:\n281:             self.aux_timebase.note(\"imu\", None, stamp, receive_s, frame_id)\n282:             self.imu_quality[\"messages\"] += 1\n283:             self.imu_quality[\"finite\"] = finite\n284:             self.imu_quality[\"last_receive_s\"] = finite_or_none(receive_s)\n285: \n286:     def note_device(self, receive_s, stamp, frame_id):\n287:         with self._lock:\n288:             self.aux_timebase.note(\"device\", None, stamp, receive_s, frame_id)\n289:             self.device_quality[\"messages\"] += 1\n290:             self.device_quality[\"last_receive_s\"] = finite_or_none(receive_s)\n291: \n292:     # -- per-frame processing -------------------------------------------------\n293: \n294:     def process(self, points, receive_s, *, seq=None, stamp_secs=None,\n295:                 stamp_nsecs=None, frame_id=None, now=None):\n296:         \"\"\"Process one decoded cloud frame; returns snapshot/state/event payloads.\n297: \n298:         ``points`` is an ``(N,3)`` array or ``None`` for a frame that could not be\n299:         decoded. ``now`` is the caller's current clock value; it drives freshness\n300:         and the published ``time_received_s``. An invalid stamp or undecodable\n301:         frame yields a diagnostic snapshot but is never registered as a valid,\n302:         selectable snapshot, and its candidates never reach the tracker/fall\n303:         history (the target is reported unobservable/unknown instead).\n304:         \"\"\"\n305:         now = finite_or_none(now)\n306:         if now is None:\n307:             now = finite_or_none(receive_s) or 0.0\n308:         receive = finite_or_none(receive_s)\n309:         frame = frame_id or self.expected_frame\n310:         with self._lock:\n311:             note = self.cloud_timebase.note(\"cloud\", seq, (stamp_secs, stamp_nsecs),\n312:                                             receive_s, frame)\n313:             if note[\"epoch_reset\"]:\n314:                 self.selection.set_epoch(self.cloud_timebase.time_epoch)\n315:             return self._process_locked(points, receive, now, seq, stamp_secs,\n316:                                         stamp_nsecs, frame)\n317: \n318:     def _process_locked(self, points, receive, now, seq, stamp_secs, stamp_nsecs,\n319:                         frame):\n320:         stream = self.cloud_timebase.streams[\"cloud\"]\n321:         epoch = self.cloud_timebase.time_epoch\n322:         self.frame_count += 1\n323:         frame_valid = bool(points is not None and stream.stamp_status != \"invalid\")\n324:         snapshot = None\n325:         candidates = []\n326:         if points is not None:\n327:             snapshot = build_snapshot(\n328:                 points, self.candidate_settings, session_id=self.session_id,\n329:                 time_epoch=epoch, snapshot_id=self._snapshot_id(seq, receive),\n330:                 seq=seq, stamp_secs=stamp_secs, stamp_nsecs=stamp_nsecs,\n331:                 source_stamp_s=stream.source_stamp_s, frame_id=frame,\n332:                 ground=self.ground, calibration=self.calibration,\n333:                 transform=self.transform, background=self.background)\n334:             if frame_valid:\n335:                 self.selection.register_snapshot(snapshot, receive if receive is not None else now)\n336:                 self._last_snapshot_id = snapshot[\"snapshot_id\"]\n337:                 self._latest_valid_snapshot = snapshot\n338:                 candidates = snapshot[\"candidates\"]\n339:             else:\n340:                 self.invalid_frames += 1\n341:         else:\n342:             self.invalid_frames += 1\n343: \n344:         source_stamp_s = stream.source_stamp_s if frame_valid else None\n345:         track_state = self.tracker.update(candidates, epoch,\n346:                                           source_stamp_s=source_stamp_s,\n347:                                           receive_s=receive)\n348:         observed = None\n349:         if frame_valid and track_state[\"candidate_id\"] is not None:\n350:             for candidate in candidates:\n351:                 if candidate[\"candidate_id\"] == track_state[\"candidate_id\"]:\n352:                     observed = candidate\n353:                     break\n354:         if observed is not None:\n355:             self._last_candidate = observed\n356:         elif not track_state.get(\"track_id\"):\n357:             # Released/unselected: drop the cached geometry so a later frame\n358:             # cannot keep publishing the previous target's position.\n359:             self._last_candidate = None\n360: \n361:         feature_block = self.features.update({\n362:             \"candidate\": observed,\n363:             \"track_id\": track_state[\"track_id\"],\n364:             \"track_status\": track_state[\"track_status\"],\n365:             \"position_predicted\": track_state[\"position_predicted\"],\n366:             \"time_epoch\": epoch,\n367:             \"session_id\": self.session_id,\n368:             \"selection_version\": track_state[\"selection_version\"],\n369:             \"action_generation\": track_state[\"action_generation\"],\n370:             \"calibration_version\": track_state[\"calibration_version\"],\n371:             \"source_stamp_s\": source_stamp_s,\n372:         }, self.baseline.baseline)\n373: \n374:         baseline_ack = self._feed_baseline(observed, track_state, source_stamp_s,\n375:                                            receive, epoch)\n376: \n377:         fall_block = self.fall.update(feature_block, {\n378:             \"source_stamp_s\": source_stamp_s,\n379:             \"time_epoch\": epoch,\n380:             \"session_id\": self.session_id,\n381:             \"selection_version\": track_state[\"selection_version\"],\n382:             \"action_generation\": track_state[\"action_generation\"],\n383:             \"calibration_version\": track_state[\"calibration_version\"],\n384:             \"track_id\": track_state[\"track_id\"],\n385:             \"track_status\": track_state[\"track_status\"],\n386:         }, self.baseline.baseline)\n387: \n388:         new_event = fall_block.get(\"new_event\")\n389:         if new_event is not None:\n390:             persisted, reason = self.event_log.append(new_event)\n391:             if reason == \"duplicate\":\n392:                 new_event = None\n393: \n394:         state = self._state_payload(now, snapshot, frame_valid, track_state,\n395:                                     feature_block, fall_block, observed)\n396:         self._last_state = state\n397:         return {\"snapshot\": snapshot, \"state\": state, \"event\": new_event,\n398:                 \"baseline_ack\": baseline_ack}\n399: \n400:     def _snapshot_id(self, seq, receive):\n401:         if seq is not None:\n402:             return \"seq:{}\".format(seq)\n403:         return \"recv:{:.6f}\".format(receive if receive is not None else 0.0)\n404: \n405:     def _feed_baseline(self, observed, track_state, source_stamp_s, receive, epoch):\n406:         if self.baseline.status != \"pending\":\n407:             return None\n408:         observation = {\n409:             \"track_id\": track_state[\"track_id\"],\n410:             \"calibration_version\": track_state[\"calibration_version\"],\n411:             \"ground_relative\": bool(observed and observed.get(\"ground_relative_available\")),\n412:             \"point_count\": None if observed is None else observed.get(\"point_count\"),\n413:             \"height_m\": None if observed is None else observed.get(\"height_m\"),\n414:             \"position_m\": None if observed is None else observed.get(\"center_source_m\"),\n415:         }\n416:         self.baseline.feed(observation, source_stamp_s=source_stamp_s,\n417:                            predicted=track_state[\"position_predicted\"],\n418:                            occluded=track_state[\"track_status\"] != \"locked\")\n419:         if self.baseline.status != self._baseline_status:\n420:             previous = self._baseline_status\n421:             self._baseline_status = self.baseline.status\n422:             if previous == \"pending\" and self.baseline.status in (\"ready\", \"failed\"):\n423:                 return self._baseline_completion_ack()\n424:         return None\n425: \n426:     def _baseline_completion_ack(self):\n427:         status = self.baseline.status\n428:         return {\n429:             \"kind\": \"selection_ack\",\n430:             \"schema_version\": SCHEMA_VERSION,\n431:             \"request_id\": self._baseline_request_id,\n432:             \"action\": \"capture_baseline\",\n433:             \"session_id\": self.session_id,\n434:             \"time_epoch\": self.selection.time_epoch,\n435:             \"accepted\": status == \"ready\",\n436:             \"reason\": None if status == \"ready\" else self.baseline.reason,\n437:             \"track_id\": self.baseline.track_id,\n438:             \"candidate_id\": None,\n439:             \"selection_version\": self.baseline.selection_version,\n440:             \"baseline\": self.baseline.snapshot(),\n441:             \"idempotent_replay\": False,\n442:         }\n443: \n444:     # -- request handling -----------------------------------------------------\n\n(Showing lines 225-444 of 688. Use offset=445 to continue.)\n</content>","metadata":{"preview":"class FallNodeCore:\n    \"\"\"One-frame-at-a-time geometry/selection/fall runtime (no ROS here).\"\"\"\n\n    def __init__(self, session_id, settings=None, ground=None, calibration=None,\n                 transform=None, background=None, event_path=None,\n                 recent_events=64, expected_frame=\"innolidar\",\n                 cloud_timeout_s=0.6, imu_timeout_s=0.3, device_timeout_s=0.6,\n                 max_forward_jump_s=30.0, clock_domain=\"monotonic\"):\n        sections = settings or {}\n        self.session_id = session_id\n        self.settings = sections\n        self.ground = ground\n        if calibration is not None and calibration.get(\"calibration_id\"):\n            self.calibration = calibration\n        else:\n            # Ground-only config: derive a stable parameter version (physical\n            # verification flags stay false) so the baseline binding is usable.\n            self.calibration = derive_ground_calibration(ground, expected_frame) \\\n                or calibration\n        self.transform = transform","truncated":true,"loaded":[],"display":{"type":"file","path":"D:\\Code\\ldiar\\src\\human_fall_detection\\core\\node_runtime.py","text":"class FallNodeCore:\n    \"\"\"One-frame-at-a-time geometry/selection/fall runtime (no ROS here).\"\"\"\n\n    def __init__(self, session_id, settings=None, ground=None, calibration=None,\n                 transform=None, background=None, event_path=None,\n                 recent_events=64, expected_frame=\"innolidar\",\n                 cloud_timeout_s=0.6, imu_timeout_s=0.3, device_timeout_s=0.6,\n                 max_forward_jump_s=30.0, clock_domain=\"monotonic\"):\n        sections = settings or {}\n        self.session_id = session_id\n        self.settings = sections\n        self.ground = ground\n        if calibration is not None and calibration.get(\"calibration_id\"):\n            self.calibration = calibration\n        else:\n            # Ground-only config: derive a stable parameter version (physical\n            # verification flags stay false) so the baseline binding is usable.\n            self.calibration = derive_ground_calibration(ground, expected_frame) \\\n                or calibration\n        self.transform = transform\n        self.background = background\n        self.expected_frame = expected_frame\n        self.clock_domain = clock_domain if clock_domain in CLOCK_DOMAINS else \"monotonic\"\n        self._lock = threading.RLock()\n        self.tracker = TargetTracker(session_id, sections.get(\"tracking\"))\n        self.features = FeatureExtractor(session_id, sections.get(\"features\"))\n        self.fall = FallStateMachine(session_id, sections.get(\"fall\"))\n        self.baseline = StanceBaselineCollector(session_id, sections.get(\"baseline\"))\n        self.selection = SelectionBackend(session_id, self.tracker, self.baseline,\n                                          sections.get(\"selection\"))\n        self.candidate_settings = sections.get(\"candidates\")\n        # Required cloud and auxiliary streams live in separate time bases so an\n        # unverified IMU/device clock reset cannot rewind the geometry epoch.\n        self.cloud_timebase = TimebaseSession(session_id, self.clock_domain,\n                                              max_forward_jump_s=max_forward_jump_s)\n        self.cloud_timebase.register(\"cloud\", cloud_timeout_s, required=True)\n        self.aux_timebase = TimebaseSession(session_id, self.clock_domain,\n                                            max_forward_jump_s=max_forward_jump_s)\n        self.aux_timebase.register(\"imu\", imu_timeout_s, required=False)\n        self.aux_timebase.register(\"device\", device_timeout_s, required=False)\n        self.event_log = EventLog(event_path, recent_events)\n        self.imu_quality = {\"messages\": 0, \"finite\": None, \"last_receive_s\": None}\n        self.device_quality = {\"messages\": 0, \"last_receive_s\": None}\n        self._last_candidate = None\n        self._last_snapshot_id = None\n        self._latest_valid_snapshot = None\n        self._baseline_request_id = None\n        self._baseline_status = self.baseline.status\n        self._last_state = None\n        self.frame_count = 0\n        self.invalid_frames = 0\n\n    # -- auxiliary stream bookkeeping (never gates the required geometry) ----\n\n    def note_imu(self, receive_s, stamp, frame_id, finite):\n        with self._lock:\n            self.aux_timebase.note(\"imu\", None, stamp, receive_s, frame_id)\n            self.imu_quality[\"messages\"] += 1\n            self.imu_quality[\"finite\"] = finite\n            self.imu_quality[\"last_receive_s\"] = finite_or_none(receive_s)\n\n    def note_device(self, receive_s, stamp, frame_id):\n        with self._lock:\n            self.aux_timebase.note(\"device\", None, stamp, receive_s, frame_id)\n            self.device_quality[\"messages\"] += 1\n            self.device_quality[\"last_receive_s\"] = finite_or_none(receive_s)\n\n    # -- per-frame processing -------------------------------------------------\n\n    def process(self, points, receive_s, *, seq=None, stamp_secs=None,\n                stamp_nsecs=None, frame_id=None, now=None):\n        \"\"\"Process one decoded cloud frame; returns snapshot/state/event payloads.\n\n        ``points`` is an ``(N,3)`` array or ``None`` for a frame that could not be\n        decoded. ``now`` is the caller's current clock value; it drives freshness\n        and the published ``time_received_s``. An invalid stamp or undecodable\n        frame yields a diagnostic snapshot but is never registered as a valid,\n        selectable snapshot, and its candidates never reach the tracker/fall\n        history (the target is reported unobservable/unknown instead).\n        \"\"\"\n        now = finite_or_none(now)\n        if now is None:\n            now = finite_or_none(receive_s) or 0.0\n        receive = finite_or_none(receive_s)\n        frame = frame_id or self.expected_frame\n        with self._lock:\n            note = self.cloud_timebase.note(\"cloud\", seq, (stamp_secs, stamp_nsecs),\n                                            receive_s, frame)\n            if note[\"epoch_reset\"]:\n                self.selection.set_epoch(self.cloud_timebase.time_epoch)\n            return self._process_locked(points, receive, now, seq, stamp_secs,\n                                        stamp_nsecs, frame)\n\n    def _process_locked(self, points, receive, now, seq, stamp_secs, stamp_nsecs,\n                        frame):\n        stream = self.cloud_timebase.streams[\"cloud\"]\n        epoch = self.cloud_timebase.time_epoch\n        self.frame_count += 1\n        frame_valid = bool(points is not None and stream.stamp_status != \"invalid\")\n        snapshot = None\n        candidates = []\n        if points is not None:\n            snapshot = build_snapshot(\n                points, self.candidate_settings, session_id=self.session_id,\n                time_epoch=epoch, snapshot_id=self._snapshot_id(seq, receive),\n                seq=seq, stamp_secs=stamp_secs, stamp_nsecs=stamp_nsecs,\n                source_stamp_s=stream.source_stamp_s, frame_id=frame,\n                ground=self.ground, calibration=self.calibration,\n                transform=self.transform, background=self.background)\n            if frame_valid:\n                self.selection.register_snapshot(snapshot, receive if receive is not None else now)\n                self._last_snapshot_id = snapshot[\"snapshot_id\"]\n                self._latest_valid_snapshot = snapshot\n                candidates = snapshot[\"candidates\"]\n            else:\n                self.invalid_frames += 1\n        else:\n            self.invalid_frames += 1\n\n        source_stamp_s = stream.source_stamp_s if frame_valid else None\n        track_state = self.tracker.update(candidates, epoch,\n                                          source_stamp_s=source_stamp_s,\n                                          receive_s=receive)\n        observed = None\n        if frame_valid and track_state[\"candidate_id\"] is not None:\n            for candidate in candidates:\n                if candidate[\"candidate_id\"] == track_state[\"candidate_id\"]:\n                    observed = candidate\n                    break\n        if observed is not None:\n            self._last_candidate = observed\n        elif not track_state.get(\"track_id\"):\n            # Released/unselected: drop the cached geometry so a later frame\n            # cannot keep publishing the previous target's position.\n            self._last_candidate = None\n\n        feature_block = self.features.update({\n            \"candidate\": observed,\n            \"track_id\": track_state[\"track_id\"],\n            \"track_status\": track_state[\"track_status\"],\n            \"position_predicted\": track_state[\"position_predicted\"],\n            \"time_epoch\": epoch,\n            \"session_id\": self.session_id,\n            \"selection_version\": track_state[\"selection_version\"],\n            \"action_generation\": track_state[\"action_generation\"],\n            \"calibration_version\": track_state[\"calibration_version\"],\n            \"source_stamp_s\": source_stamp_s,\n        }, self.baseline.baseline)\n\n        baseline_ack = self._feed_baseline(observed, track_state, source_stamp_s,\n                                           receive, epoch)\n\n        fall_block = self.fall.update(feature_block, {\n            \"source_stamp_s\": source_stamp_s,\n            \"time_epoch\": epoch,\n            \"session_id\": self.session_id,\n            \"selection_version\": track_state[\"selection_version\"],\n            \"action_generation\": track_state[\"action_generation\"],\n            \"calibration_version\": track_state[\"calibration_version\"],\n            \"track_id\": track_state[\"track_id\"],\n            \"track_status\": track_state[\"track_status\"],\n        }, self.baseline.baseline)\n\n        new_event = fall_block.get(\"new_event\")\n        if new_event is not None:\n            persisted, reason = self.event_log.append(new_event)\n            if reason == \"duplicate\":\n                new_event = None\n\n        state = self._state_payload(now, snapshot, frame_valid, track_state,\n                                    feature_block, fall_block, observed)\n        self._last_state = state\n        return {\"snapshot\": snapshot, \"state\": state, \"event\": new_event,\n                \"baseline_ack\": baseline_ack}\n\n    def _snapshot_id(self, seq, receive):\n        if seq is not None:\n            return \"seq:{}\".format(seq)\n        return \"recv:{:.6f}\".format(receive if receive is not None else 0.0)\n\n    def _feed_baseline(self, observed, track_state, source_stamp_s, receive, epoch):\n        if self.baseline.status != \"pending\":\n            return None\n        observation = {\n            \"track_id\": track_state[\"track_id\"],\n            \"calibration_version\": track_state[\"calibration_version\"],\n            \"ground_relative\": bool(observed and observed.get(\"ground_relative_available\")),\n            \"point_count\": None if observed is None else observed.get(\"point_count\"),\n            \"height_m\": None if observed is None else observed.get(\"height_m\"),\n            \"position_m\": None if observed is None else observed.get(\"center_source_m\"),\n        }\n        self.baseline.feed(observation, source_stamp_s=source_stamp_s,\n                           predicted=track_state[\"position_predicted\"],\n                           occluded=track_state[\"track_status\"] != \"locked\")\n        if self.baseline.status != self._baseline_status:\n            previous = self._baseline_status\n            self._baseline_status = self.baseline.status\n            if previous == \"pending\" and self.baseline.status in (\"ready\", \"failed\"):\n                return self._baseline_completion_ack()\n        return None\n\n    def _baseline_completion_ack(self):\n        status = self.baseline.status\n        return {\n            \"kind\": \"selection_ack\",\n            \"schema_version\": SCHEMA_VERSION,\n            \"request_id\": self._baseline_request_id,\n            \"action\": \"capture_baseline\",\n            \"session_id\": self.session_id,\n            \"time_epoch\": self.selection.time_epoch,\n            \"accepted\": status == \"ready\",\n            \"reason\": None if status == \"ready\" else self.baseline.reason,\n            \"track_id\": self.baseline.track_id,\n            \"candidate_id\": None,\n            \"selection_version\": self.baseline.selection_version,\n            \"baseline\": self.baseline.snapshot(),\n            \"idempotent_replay\": False,\n        }\n\n    # -- request handling -----------------------------------------------------","lineStart":225,"lineEnd":444,"totalLines":688,"truncated":true}},"title":"src\\human_fall_detection\\core\\node_runtime.py","time":{"start":1790810659617,"end":1790810659636}},"id":"prt_0f4a21825001DVKjchMpubVkSH","sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","messageID":"msg_0f4a1af99001xcg3fNtb7CEXp6"}}
