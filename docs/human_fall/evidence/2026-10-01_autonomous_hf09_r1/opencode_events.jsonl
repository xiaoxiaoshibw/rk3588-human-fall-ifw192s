sh; source /root/catkin_ws/devel/setup.bash; echo ---topics---; rostopic list; echo ---points_hz---; timeout 12 rostopic hz /innolidar_points 2>&1 | head -5; echo ---imu_hz---; timeout 8 rostopic hz /inno_imu 2>&1 | head -4'\"","time":{"start":1790810562833,"end":1790810612775}},"id":"prt_0f4a099b0001D7ilP52dqMflNt","sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","messageID":"msg_0f4a056b3001XXnKjgRpEE4RBc"}}
