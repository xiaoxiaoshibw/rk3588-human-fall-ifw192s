{"type":"tool_use","timestamp":1790810623058,"sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","part":{"type":"tool","tool":"read","callID":"call_9d295e7c446449148a6a456b","state":{"status":"completed","input":{"filePath":"D:\\Code\\ldiar\\src\\human_fall_detection\\scripts\\human_fall_node.py"},"output":"<path>D:\\Code\\ldiar\\src\\human_fall_detection\\scripts\\human_fall_node.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"ROS1 node for the HF-04..06 geometry/fall chain (HF-07). Read-only output.\n3: \n4: Message plumbing only: the point-cloud callback records the real receive clock\n5: and drops the frame into a bounded latest-frame queue, a single worker thread\n6: decodes and runs the pure :class:`core.node_runtime.FallNodeCore`, and requests\n7: are answered through the same locked core. Nothing here publishes vehicle\n8: commands; the only input topic is operator selection/baseline requests.\n9: \n10: Runtime contract exercised by this file:\n11: \n12: - bounded queue + single writer, so a slow frame computation never blocks the\n13:   sensor callbacks;\n14: - illegal stamps / undecodable clouds keep an explicit invalid/unknown state\n15:   instead of a fabricated normal scene;\n16: - selection requests are validated by the board-side backend (schema/epoch/\n17:   snapshot/quality/version) and only its ack is authoritative;\n18: - fall events are de-duplicated and appended to a local JSONL log; a write\n19:   failure is surfaced, never reported as a successful save.\n20: \"\"\"\n21: \n22: import argparse\n23: import json\n24: import os\n25: import threading\n26: import time\n27: \n28: SCHEMA_VERSION = 1\n29: \n30: \n31: def load_yaml(path):\n32:     try:\n33:         import yaml\n34:     except ImportError as exc:  # pragma: no cover - runtime dependency\n35:         raise RuntimeError(\"PyYAML is required: \" + str(exc))\n36:     with open(path, encoding=\"utf-8\") as source:\n37:         return yaml.safe_load(source) or {}\n38: \n39: \n40: def _resolve_relative(base_dir, path):\n41:     if path is None:\n42:         return None\n43:     if os.path.isabs(path):\n44:         return path\n45:     return os.path.abspath(os.path.join(base_dir, path))\n46: \n47: \n48: def load_ground_context(config, config_dir):\n49:     \"\"\"Return (ground, calibration, background) from config paths.\n50: \n51:     A configured path that is present but unreadable/invalid raises, so a\n52:     mis-declared calibration never silently degrades to \"no ground\". No path\n53:     configured is a legitimate waiting state (``ground=None``).\n54:     \"\"\"\n55:     ground = None\n56:     calibration = None\n57:     background = None\n58:     calibration_path = _resolve_relative(config_dir, config.get(\"calibration_path\"))\n59:     ground_path = _resolve_relative(config_dir, config.get(\"ground_path\"))\n60:     background_path = _resolve_relative(config_dir, config.get(\"background_path\"))\n61:     if calibration_path:\n62:         from core.calibration import validate_geometry_calibration\n63:         with open(calibration_path, encoding=\"utf-8\") as handle:\n64:             artifact = validate_geometry_calibration(json.load(handle))\n65:         calibration = artifact\n66:         ground = artifact.get(\"ground\")\n67:     elif ground_path:\n68:         from core.ground import validate_ground_plane\n69:         with open(ground_path, encoding=\"utf-8\") as handle:\n70:             record = json.load(handle)\n71:         if isinstance(record, dict) and \"ground\" in record:\n72:             record = record[\"ground\"]\n73:         ground = validate_ground_plane(record) if record is not None else None\n74:     if background_path:\n75:         with open(background_path, encoding=\"utf-8\") as handle:\n76:             background = json.load(handle)\n77:     return ground, calibration, background\n78: \n79: \n80: def build_core(config, perception, *, session_id, config_dir, event_path):\n81:     from core.node_runtime import FallNodeCore\n82:     topics = config.get(\"topics\", {})\n83:     timeouts = config.get(\"timeouts_s\", {})\n84:     stamps = config.get(\"stamps\", {})\n85:     checks = config.get(\"checks\", {})\n86:     ground, calibration, background = load_ground_context(config.get(\"geometry\", {}),\n87:                                                           config_dir)\n88:     clock_domain = \"message_time\" if config.get(\"mode\", {}).get(\"replay\") else \"monotonic\"\n89:     return FallNodeCore(\n90:         session_id, perception, ground=ground, calibration=calibration,\n91:         background=background, event_path=event_path,\n92:         recent_events=int(config.get(\"output\", {}).get(\"recent_events\", 64)),\n93:         expected_frame=checks.get(\"expected_cloud_frame\") or \"innolidar\",\n94:         cloud_timeout_s=float(timeouts.get(\"cloud_stale\", 0.6)),\n95:         imu_timeout_s=float(timeouts.get(\"imu_stale\", 0.3)),\n96:         device_timeout_s=float(timeouts.get(\"device_stale\", 0.6)),\n97:         max_forward_jump_s=float(stamps.get(\"max_forward_jump_s\", 30.0)),\n98:         clock_domain=clock_domain)\n99: \n100: \n101: def main(argv=None):\n102:     parser = argparse.ArgumentParser(description=__doc__)\n103:     parser.add_argument(\"--config\", default=None,\n104:                         help=\"node YAML; defaults to the package config/human_fall.yaml\")\n105:     parser.add_argument(\"--perception\", default=None,\n106:                         help=\"perception sections YAML; defaults to config/perception.yaml\")\n107:     parser.add_argument(\"--session-id\", default=None)\n108:     parser.add_argument(\"--output-dir\", default=None)\n109:     # Unknown args are ROS remaps/params (e.g. ``_config:=...``); they must not\n110:     # make a standalone or roslaunch invocation fail argument parsing.\n111:     args, _unknown = parser.parse_known_args(argv)\n112:     try:\n113:         import rospy\n114:         import rospkg\n115:         from sensor_msgs.msg import Imu, PointCloud2\n116:         from std_msgs.msg import String\n117:         from inno_lidar_msg.msg import DeviceStatus\n118:     except ImportError as exc:\n119:         parser.exit(2, \"ROS1 rospy/rospkg/sensor_msgs/std_msgs/inno_lidar_msg required: {}\\n\"\n120:                     .format(exc))\n121: \n122:     rospy.init_node(\"human_fall_node\", disable_signals=False)\n123:     package_dir = rospkg.RosPack().get_path(\"human_fall_detection\")\n124:     config_path = (rospy.get_param(\"~config\", None) or args.config\n125:                    or os.path.join(package_dir, \"config\", \"human_fall.yaml\"))\n126:     config_dir = os.path.dirname(os.path.abspath(config_path))\n127:     config = load_yaml(config_path)\n128:     perception_path = (rospy.get_param(\"~perception\", None) or args.perception\n129:                        or os.path.join(config_dir, \"perception.yaml\"))\n130:     perception = load_yaml(perception_path)\n131: \n132:     session_id = (args.session_id or rospy.get_param(\"~session_id\", \"\")\n133:                   or config.get(\"session_id\") or \"\")\n134:     if not session_id:\n135:         session_id = \"hfd_\" + time.strftime(\"%Y%m%d_%H%M%S\", time.gmtime())\n136: \n137:     output = config.get(\"output\", {})\n138:     output_dir = (args.output_dir or rospy.get_param(\"~output_dir\", \"\")\n139:                   or output.get(\"session_dir\") or \"/root/catkin_ws/human_fall_sessions\")\n140:     event_path = os.path.join(output_dir, str(output.get(\"event_file\", \"events.jsonl\")))\n141: \n142:     mode = config.get(\"mode\", {})\n143:     require_ground = bool(mode.get(\"require_ground\", False))\n144:     core = build_core(config, perception, session_id=session_id,\n145:                       config_dir=config_dir, event_path=event_path)\n146:     if require_ground and not core._ground_valid():\n147:         parser.exit(3, \"no valid ground configured and mode.require_ground is true\\n\")\n148: \n149:     from sensor_health import _load_xyz_from_cloud, dumps_strict, stamp_pair\n150:     xyz_from_cloud, calibration_error = _load_xyz_from_cloud()\n151:     if xyz_from_cloud is None:\n152:         parser.exit(2, \"human_follow_calibration.xyz_from_cloud is unavailable; \"\n153:                        \"the required point-cloud decoder could not be loaded\\n\")\n154: \n155:     topics = config.get(\"topics\", {})\n156:     cloud_topic = topics.get(\"cloud\", \"/innolidar_points\")\n157:     imu_topic = topics.get(\"imu\", \"/inno_imu\")\n158:     device_topic = topics.get(\"device_status\", \"/device_status\")\n159:     publish_period = float(config.get(\"publish_period_s\", 0.5))\n160:     cloud_stale_s = float(config.get(\"timeouts_s\", {}).get(\"cloud_stale\", 0.6))\n161: \n162:     publishers = {\n163:         \"candidates\": rospy.Publisher(topics.get(\"candidates\", \"/human_fall/candidates\"),\n164:                                       String, queue_size=1),\n165:         \"state\": rospy.Publisher(topics.get(\"state\", \"/human_fall/state\"),\n166:                                  String, queue_size=1),\n167:         \"event\": rospy.Publisher(topics.get(\"event\", \"/human_fall/event\"),\n168:                                  String, queue_size=4),\n169:         \"ack\": rospy.Publisher(topics.get(\"selection_ack\", \"/human_fall/selection_ack\"),\n170:                                String, queue_size=4),\n171:     }\n172: \n173:     from core.node_runtime import LatestFrameQueue\n174:     queue = LatestFrameQueue(1)\n175:     stop = threading.Event()\n176: \n177:     def on_cloud(msg):\n178:         queue.put((time.monotonic(), msg))\n179: \n180:     def on_imu(msg):\n181:         from core.sensor_quality import six_axis_report\n182:         report = six_axis_report(\n183:             (msg.linear_acceleration.x, msg.linear_acceleration.y, msg.linear_acceleration.z),\n184:             (msg.angular_velocity.x, msg.angular_velocity.y, msg.angular_velocity.z))\n185:         try:\n186:             core.note_imu(time.monotonic(), stamp_pair(msg.header.stamp),\n187:                           msg.header.frame_id, report[\"finite\"])\n188:         except Exception as exc:  # noqa: BLE001 - auxiliary stream never fatal\n189:             rospy.logwarn_throttle(10.0, \"human_fall_node IMU note failed: %s\", exc)\n190: \n191:     def on_device(msg):\n192:         try:\n193:             core.note_device(time.monotonic(), stamp_pair(msg.header.stamp),\n194:                              msg.header.frame_id)\n195:         except Exception as exc:  # noqa: BLE001\n196:             rospy.logwarn_throttle(10.0, \"human_fall_node device note failed: %s\", exc)\n197: \n198:     def on_request(msg):\n199:         receive_s = time.monotonic()\n200:         try:\n201:             request = json.loads(msg.data)\n202:         except (TypeError, ValueError):\n203:             request = None\n204:         ack = core.handle_request(request, receive_s)\n205:         _publish(publishers[\"ack\"], ack)\n206: \n207:     def _publish(publisher, payload):\n208:         try:\n209:             publisher.publish(String(data=dumps_strict(payload)))\n210:         except ValueError as exc:\n211:             rospy.logerr(\"Refusing non-finite payload on %s: %s\", publisher.name, exc)\n212: \n213:     rospy.Subscriber(cloud_topic, PointCloud2, on_cloud, queue_size=1,\n214:                      buff_size=2 ** 24)\n215:     rospy.Subscriber(imu_topic, Imu, on_imu, queue_size=64)\n216:     rospy.Subscriber(device_topic, DeviceStatus, on_device, queue_size=8)\n217:     rospy.Subscriber(topics.get(\"selection_request\", \"/human_fall/selection_request\"),\n218:                      String, on_request, queue_size=16)\n219: \n220:     def worker():\n221:         while not stop.is_set():\n222:             got = queue.wait(publish_period)\n223:             item = queue.take() if got else None\n224:             if item is None:\n225:                 if stop.is_set():\n226:                     break\n227:                 state = core.status_state(time.monotonic())\n228:                 _publish(publishers[\"state\"], state)\n229:                 continue\n230:             receive_s, msg = item\n231:             now = time.monotonic()\n232:             # A queued frame that is already older than the required-cloud\n233:             # timeout must not be treated as fresh; drop it and only report the\n234:             # current (stale) status. Processing time, not the frame's arrival\n235:             # time, is the online clock for freshness.\n236:             if now - receive_s > cloud_stale_s:\n237:                 rospy.logwarn_throttle(5.0, \"human_fall_node dropping stale queued frame (%.2fs)\",\n238:                                        now - receive_s)\n239:                 _publish(publishers[\"state\"], core.status_state(now))\n240:                 continue\n241:             points = None\n242:             try:\n243:                 points = xyz_from_cloud(msg, 0.0)\n244:             except (ValueError, calibration_error) as exc:  # type: ignore[misc]\n245:                 rospy.logwarn_throttle(5.0, \"human_fall_node cloud decode failed: %s\", exc)\n246:             result = core.process(\n247:                 points, receive_s, seq=getattr(msg.header, \"seq\", None),\n248:                 stamp_secs=stamp_pair(msg.header.stamp)[0],\n249:                 stamp_nsecs=stamp_pair(msg.header.stamp)[1],\n250:                 frame_id=msg.header.frame_id or None, now=now)\n251:             if result[\"snapshot\"] is not None:\n252:                 _publish(publishers[\"candidates\"], result[\"snapshot\"])\n253:             _publish(publishers[\"state\"], result[\"state\"])\n254:             if result[\"event\"] is not None:\n255:                 _publish(publishers[\"event\"], result[\"event\"])\n256:             if result[\"baseline_ack\"] is not None:\n257:                 _publish(publishers[\"ack\"], result[\"baseline_ack\"])\n258: \n259:     def shutdown():\n260:         stop.set()\n261:         queue.put(None)\n262:         queue.wake()\n263: \n264:     rospy.on_shutdown(shutdown)\n265:     thread = threading.Thread(target=worker, name=\"human_fall_worker\", daemon=True)\n266:     thread.start()\n267:     rospy.loginfo(\"human_fall_node: %s + %s + %s -> %s (session %s, ground=%s, events=%s)\",\n268:                   cloud_topic, imu_topic, device_topic, publishers[\"state\"].name,\n269:                   session_id, \"valid\" if core._ground_valid() else \"unavailable\",\n270:                   event_path)\n271:     rate = rospy.Rate(10.0)\n272:     while not rospy.is_shutdown():\n273:         rate.sleep()\n274:     stop.set()\n275:     queue.put(None)\n276:     queue.wake()\n277:     thread.join(timeout=5.0)\n278:     return 0\n279: \n280: \n281: if __name__ == \"__main__\":\n282:     raise SystemExit(main())\n\n(End of file - total 282 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"ROS1 node for the HF-04..06 geometry/fall chain (HF-07). Read-only output.\n\nMessage plumbing only: the point-cloud callback records the real receive clock\nand drops the frame into a bounded latest-frame queue, a single worker thread\ndecodes and runs the pure :class:`core.node_runtime.FallNodeCore`, and requests\nare answered through the same locked core. Nothing here publishes vehicle\ncommands; the only input topic is operator selection/baseline requests.\n\nRuntime contract exercised by this file:\n\n- bounded queue + single writer, so a slow frame computation never blocks the\n  sensor callbacks;\n- illegal stamps / undecodable clouds keep an explicit invalid/unknown state\n  instead of a fabricated normal scene;\n- selection requests are validated by the board-side backend (schema/epoch/\n  snapshot/quality/version) and only its ack is authoritative;\n- fall events are de-duplicated and appended to a local JSONL log; a write\n  failure is surfaced, never reported as a successful save.\n\"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"D:\\Code\\ldiar\\src\\human_fall_detection\\scripts\\human_fall_node.py","text":"#!/usr/bin/env python3\n\"\"\"ROS1 node for the HF-04..06 geometry/fall chain (HF-07). Read-only output.\n\nMessage plumbing only: the point-cloud callback records the real receive clock\nand drops the frame into a bounded latest-frame queue, a single worker thread\ndecodes and runs the pure :class:`core.node_runtime.FallNodeCore`, and requests\nare answered through the same locked core. Nothing here publishes vehicle\ncommands; the only input topic is operator selection/baseline requests.\n\nRuntime contract exercised by this file:\n\n- bounded queue + single writer, so a slow frame computation never blocks the\n  sensor callbacks;\n- illegal stamps / undecodable clouds keep an explicit invalid/unknown state\n  instead of a fabricated normal scene;\n- selection requests are validated by the board-side backend (schema/epoch/\n  snapshot/quality/version) and only its ack is authoritative;\n- fall events are de-duplicated and appended to a local JSONL log; a write\n  failure is surfaced, never reported as a successful save.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport threading\nimport time\n\nSCHEMA_VERSION = 1\n\n\ndef load_yaml(path):\n    try:\n        import yaml\n    except ImportError as exc:  # pragma: no cover - runtime dependency\n        raise RuntimeError(\"PyYAML is required: \" + str(exc))\n    with open(path, encoding=\"utf-8\") as source:\n        return yaml.safe_load(source) or {}\n\n\ndef _resolve_relative(base_dir, path):\n    if path is None:\n        return None\n    if os.path.isabs(path):\n        return path\n    return os.path.abspath(os.path.join(base_dir, path))\n\n\ndef load_ground_context(config, config_dir):\n    \"\"\"Return (ground, calibration, background) from config paths.\n\n    A configured path that is present but unreadable/invalid raises, so a\n    mis-declared calibration never silently degrades to \"no ground\". No path\n    configured is a legitimate waiting state (``ground=None``).\n    \"\"\"\n    ground = None\n    calibration = None\n    background = None\n    calibration_path = _resolve_relative(config_dir, config.get(\"calibration_path\"))\n    ground_path = _resolve_relative(config_dir, config.get(\"ground_path\"))\n    background_path = _resolve_relative(config_dir, config.get(\"background_path\"))\n    if calibration_path:\n        from core.calibration import validate_geometry_calibration\n        with open(calibration_path, encoding=\"utf-8\") as handle:\n            artifact = validate_geometry_calibration(json.load(handle))\n        calibration = artifact\n        ground = artifact.get(\"ground\")\n    elif ground_path:\n        from core.ground import validate_ground_plane\n        with open(ground_path, encoding=\"utf-8\") as handle:\n            record = json.load(handle)\n        if isinstance(record, dict) and \"ground\" in record:\n            record = record[\"ground\"]\n        ground = validate_ground_plane(record) if record is not None else None\n    if background_path:\n        with open(background_path, encoding=\"utf-8\") as handle:\n            background = json.load(handle)\n    return ground, calibration, background\n\n\ndef build_core(config, perception, *, session_id, config_dir, event_path):\n    from core.node_runtime import FallNodeCore\n    topics = config.get(\"topics\", {})\n    timeouts = config.get(\"timeouts_s\", {})\n    stamps = config.get(\"stamps\", {})\n    checks = config.get(\"checks\", {})\n    ground, calibration, background = load_ground_context(config.get(\"geometry\", {}),\n                                                          config_dir)\n    clock_domain = \"message_time\" if config.get(\"mode\", {}).get(\"replay\") else \"monotonic\"\n    return FallNodeCore(\n        session_id, perception, ground=ground, calibration=calibration,\n        background=background, event_path=event_path,\n        recent_events=int(config.get(\"output\", {}).get(\"recent_events\", 64)),\n        expected_frame=checks.get(\"expected_cloud_frame\") or \"innolidar\",\n        cloud_timeout_s=float(timeouts.get(\"cloud_stale\", 0.6)),\n        imu_timeout_s=float(timeouts.get(\"imu_stale\", 0.3)),\n        device_timeout_s=float(timeouts.get(\"device_stale\", 0.6)),\n        max_forward_jump_s=float(stamps.get(\"max_forward_jump_s\", 30.0)),\n        clock_domain=clock_domain)\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--config\", default=None,\n                        help=\"node YAML; defaults to the package config/human_fall.yaml\")\n    parser.add_argument(\"--perception\", default=None,\n                        help=\"perception sections YAML; defaults to config/perception.yaml\")\n    parser.add_argument(\"--session-id\", default=None)\n    parser.add_argument(\"--output-dir\", default=None)\n    # Unknown args are ROS remaps/params (e.g. ``_config:=...``); they must not\n    # make a standalone or roslaunch invocation fail argument parsing.\n    args, _unknown = parser.parse_known_args(argv)\n    try:\n        import rospy\n        import rospkg\n        from sensor_msgs.msg import Imu, PointCloud2\n        from std_msgs.msg import String\n        from inno_lidar_msg.msg import DeviceStatus\n    except ImportError as exc:\n        parser.exit(2, \"ROS1 rospy/rospkg/sensor_msgs/std_msgs/inno_lidar_msg required: {}\\n\"\n                    .format(exc))\n\n    rospy.init_node(\"human_fall_node\", disable_signals=False)\n    package_dir = rospkg.RosPack().get_path(\"human_fall_detection\")\n    config_path = (rospy.get_param(\"~config\", None) or args.config\n                   or os.path.join(package_dir, \"config\", \"human_fall.yaml\"))\n    config_dir = os.path.dirname(os.path.abspath(config_path))\n    config = load_yaml(config_path)\n    perception_path = (rospy.get_param(\"~perception\", None) or args.perception\n                       or os.path.join(config_dir, \"perception.yaml\"))\n    perception = load_yaml(perception_path)\n\n    session_id = (args.session_id or rospy.get_param(\"~session_id\", \"\")\n                  or config.get(\"session_id\") or \"\")\n    if not session_id:\n        session_id = \"hfd_\" + time.strftime(\"%Y%m%d_%H%M%S\", time.gmtime())\n\n    output = config.get(\"output\", {})\n    output_dir = (args.output_dir or rospy.get_param(\"~output_dir\", \"\")\n                  or output.get(\"session_dir\") or \"/root/catkin_ws/human_fall_sessions\")\n    event_path = os.path.join(output_dir, str(output.get(\"event_file\", \"events.jsonl\")))\n\n    mode = config.get(\"mode\", {})\n    require_ground = bool(mode.get(\"require_ground\", False))\n    core = build_core(config, perception, session_id=session_id,\n                      config_dir=config_dir, event_path=event_path)\n    if require_ground and not core._ground_valid():\n        parser.exit(3, \"no valid ground configured and mode.require_ground is true\\n\")\n\n    from sensor_health import _load_xyz_from_cloud, dumps_strict, stamp_pair\n    xyz_from_cloud, calibration_error = _load_xyz_from_cloud()\n    if xyz_from_cloud is None:\n        parser.exit(2, \"human_follow_calibration.xyz_from_cloud is unavailable; \"\n                       \"the required point-cloud decoder could not be loaded\\n\")\n\n    topics = config.get(\"topics\", {})\n    cloud_topic = topics.get(\"cloud\", \"/innolidar_points\")\n    imu_topic = topics.get(\"imu\", \"/inno_imu\")\n    device_topic = topics.get(\"device_status\", \"/device_status\")\n    publish_period = float(config.get(\"publish_period_s\", 0.5))\n    cloud_stale_s = float(config.get(\"timeouts_s\", {}).get(\"cloud_stale\", 0.6))\n\n    publishers = {\n        \"candidates\": rospy.Publisher(topics.get(\"candidates\", \"/human_fall/candidates\"),\n                                      String, queue_size=1),\n        \"state\": rospy.Publisher(topics.get(\"state\", \"/human_fall/state\"),\n                                 String, queue_size=1),\n        \"event\": rospy.Publisher(topics.get(\"event\", \"/human_fall/event\"),\n                                 String, queue_size=4),\n        \"ack\": rospy.Publisher(topics.get(\"selection_ack\", \"/human_fall/selection_ack\"),\n                               String, queue_size=4),\n    }\n\n    from core.node_runtime import LatestFrameQueue\n    queue = LatestFrameQueue(1)\n    stop = threading.Event()\n\n    def on_cloud(msg):\n        queue.put((time.monotonic(), msg))\n\n    def on_imu(msg):\n        from core.sensor_quality import six_axis_report\n        report = six_axis_report(\n            (msg.linear_acceleration.x, msg.linear_acceleration.y, msg.linear_acceleration.z),\n            (msg.angular_velocity.x, msg.angular_velocity.y, msg.angular_velocity.z))\n        try:\n            core.note_imu(time.monotonic(), stamp_pair(msg.header.stamp),\n                          msg.header.frame_id, report[\"finite\"])\n        except Exception as exc:  # noqa: BLE001 - auxiliary stream never fatal\n            rospy.logwarn_throttle(10.0, \"human_fall_node IMU note failed: %s\", exc)\n\n    def on_device(msg):\n        try:\n            core.note_device(time.monotonic(), stamp_pair(msg.header.stamp),\n                             msg.header.frame_id)\n        except Exception as exc:  # noqa: BLE001\n            rospy.logwarn_throttle(10.0, \"human_fall_node device note failed: %s\", exc)\n\n    def on_request(msg):\n        receive_s = time.monotonic()\n        try:\n            request = json.loads(msg.data)\n        except (TypeError, ValueError):\n            request = None\n        ack = core.handle_request(request, receive_s)\n        _publish(publishers[\"ack\"], ack)\n\n    def _publish(publisher, payload):\n        try:\n            publisher.publish(String(data=dumps_strict(payload)))\n        except ValueError as exc:\n            rospy.logerr(\"Refusing non-finite payload on %s: %s\", publisher.name, exc)\n\n    rospy.Subscriber(cloud_topic, PointCloud2, on_cloud, queue_size=1,\n                     buff_size=2 ** 24)\n    rospy.Subscriber(imu_topic, Imu, on_imu, queue_size=64)\n    rospy.Subscriber(device_topic, DeviceStatus, on_device, queue_size=8)\n    rospy.Subscriber(topics.get(\"selection_request\", \"/human_fall/selection_request\"),\n                     String, on_request, queue_size=16)\n\n    def worker():\n        while not stop.is_set():\n            got = queue.wait(publish_period)\n            item = queue.take() if got else None\n            if item is None:\n                if stop.is_set():\n                    break\n                state = core.status_state(time.monotonic())\n                _publish(publishers[\"state\"], state)\n                continue\n            receive_s, msg = item\n            now = time.monotonic()\n            # A queued frame that is already older than the required-cloud\n            # timeout must not be treated as fresh; drop it and only report the\n            # current (stale) status. Processing time, not the frame's arrival\n            # time, is the online clock for freshness.\n            if now - receive_s > cloud_stale_s:\n                rospy.logwarn_throttle(5.0, \"human_fall_node dropping stale queued frame (%.2fs)\",\n                                       now - receive_s)\n                _publish(publishers[\"state\"], core.status_state(now))\n                continue\n            points = None\n            try:\n                points = xyz_from_cloud(msg, 0.0)\n            except (ValueError, calibration_error) as exc:  # type: ignore[misc]\n                rospy.logwarn_throttle(5.0, \"human_fall_node cloud decode failed: %s\", exc)\n            result = core.process(\n                points, receive_s, seq=getattr(msg.header, \"seq\", None),\n                stamp_secs=stamp_pair(msg.header.stamp)[0],\n                stamp_nsecs=stamp_pair(msg.header.stamp)[1],\n                frame_id=msg.header.frame_id or None, now=now)\n            if result[\"snapshot\"] is not None:\n                _publish(publishers[\"candidates\"], result[\"snapshot\"])\n            _publish(publishers[\"state\"], result[\"state\"])\n            if result[\"event\"] is not None:\n                _publish(publishers[\"event\"], result[\"event\"])\n            if result[\"baseline_ack\"] is not None:\n                _publish(publishers[\"ack\"], result[\"baseline_ack\"])\n\n    def shutdown():\n        stop.set()\n        queue.put(None)\n        queue.wake()\n\n    rospy.on_shutdown(shutdown)\n    thread = threading.Thread(target=worker, name=\"human_fall_worker\", daemon=True)\n    thread.start()\n    rospy.loginfo(\"human_fall_node: %s + %s + %s -> %s (session %s, ground=%s, events=%s)\",\n                  cloud_topic, imu_topic, device_topic, publishers[\"state\"].name,\n                  session_id, \"valid\" if core._ground_valid() else \"unavailable\",\n                  event_path)\n    rate = rospy.Rate(10.0)\n    while not rospy.is_shutdown():\n        rate.sleep()\n    stop.set()\n    queue.put(None)\n    queue.wake()\n    thread.join(timeout=5.0)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":282,"totalLines":282,"truncated":false}},"title":"src\\human_fall_detection\\scripts\\human_fall_node.py","time":{"start":1790810623039,"end":1790810623053}},"id":"prt_0f4a18a85001nqeXegr59qhI3K","sessionID":"ses_f0b628b84ffefnOtctWabVpJsw","messageID":"msg_0f4a1691600101o1Bu2ueQmUyu"}}
