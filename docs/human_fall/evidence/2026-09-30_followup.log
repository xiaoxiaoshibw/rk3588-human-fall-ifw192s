[DRIVER_CONFIG]
common:
  msg_source: 1                                         #0: not use Lidar
                                                        #1: packet message comes from online Lidar
                                                        #2: packet message comes from Pcap file
  send_point_cloud_ros: true                            #true: Send point cloud through ROS or ROS2
lidar:
  - driver:
      lidar_type: IFW192S
      point_type: 0                             #point cloud type 0(x,y,z,intensity,ring) 1(x,y,z,intensity,ring,time)
      cloud_port: 8080                          #cloud port of lidar (pc port)
      check_lidar_ip: 192.168.1.10              #check param of lidar device UDP (lidar ip)
      h_start_angle: -60                        #herizon Start angle (IFW192S-B H FOV 120°, 居中±60°)
      h_end_angle: 60                           #herizon End angle of point cloud
      v_start_angle: -45                        #vertical Start angle (IFW192S-B V FOV 90°, 居中±45°)
      v_end_angle: 45                           #vertical End angle of point cloud
      min_distance: 0.02                        #Minimum distance of point cloud
      max_distance: 30                          #Maximum distance (IFW192S-B 30m@10% reflectivity)
      pcap_repeat: true                         #True--repeat play pcap file
      is_device_load_calibration: false           #True--Use calibration from lidar device (本地 ifw192s 标定不适用 FW192SB)
      calibrate_folder: /root/catkin_ws/src/inno_lidar_ros/config/ifw192s #fallback (msg_source=1 时优先用设备标定)
      pcap_file: /home/wenjie/project/pcap/ifw192s/71_2.pcap #The path of pcap file (msg_source=1 时不读)
      extrinsic:
        use_status: true                        #
        roll: 0                                 #
        pitch: 0                                #
        yaw: 0                                  #
        x: 0                                    #
        y: 0                                    #
        z: 0                                    #
        
    ros:
      ros_frame_id: innolidar                             #Frame id of packet message and point cloud message
      ros_send_point_cloud_topic: /innolidar_points       #Topic used to send point cloud through ROS
      ros_send_imu_topic: /inno_imu                       #Topic used to send point cloud through ROS
      ros_device_status_send_topic: /device_status        #Topic used to send point cloud through ROS
      

